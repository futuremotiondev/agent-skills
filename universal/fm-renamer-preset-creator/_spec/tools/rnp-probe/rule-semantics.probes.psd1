  @{ Name = 'Case WHAT=3 capitalize every word'; Files = @('hELLO wORLD. tHE eND.TXT'); Rules = @(@{ ID = 'Case'; Config = @('WHAT=3', 'PRESERVECASE=0', 'SKIPEXTENSION=1', 'EXTENSIONALWAYSLOWERCASE=0', 'EXTENSIONALWAYSUPPERCASE=0', 'FORCECASE=0', 'FRAGMENTSTEXT=') }); Expect = @('Hello World. The End.TXT') }
