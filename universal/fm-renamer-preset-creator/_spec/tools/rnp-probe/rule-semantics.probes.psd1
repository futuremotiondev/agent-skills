# Regression suite for reference/rnp-format.md — every enum value and behaviour claimed there is asserted here.
# Run:  ./Invoke-RnpProbe.ps1 -CaseFile ./rule-semantics.probes.psd1      (re-run after every ReNamer update)
# Expected values were observed on ReNamer 7.10.0.0 (portable), 2026-09-27. Cases without Expect/ExpectExit are informational
# (UNRESOLVED items); every other case asserts both the resulting names and the exit code (default 0).
@{ Cases = @(
  # ---------------- File format / encoding ----------------
  @{ Name = 'FORMAT encoder: space as + and punctuation as %XX'; Files = @('aa.txt'); Rules = @(@{ ID = 'Insert'; Config = @('TEXT=X-_.(1) ', 'WHERE=1', 'POSITION=1', 'INSERTAFTERTEXT=', 'INSERTBEFORETEXT=', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1') }); Expect = @('X-_.(1) aa.txt') }
  @{ Name = 'FORMAT reader tolerates %20, lowercase hex, raw -_.'; Files = @('aa.txt'); Rules = @(@{ ID = 'Insert'; Encoded = $true; Config = @('TEXT=X%20Y%2d_.%c3%a9 ', 'WHERE=1', 'POSITION=1', 'INSERTAFTERTEXT=', 'INSERTBEFORETEXT=', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1') }); Expect = @('X Y-_.é aa.txt') }
  @{ Name = 'FORMAT Marked=0 rule is skipped'; Files = @('aa.txt'); Rules = @(@{ ID = 'Insert'; Marked = 0; Config = @('TEXT=NO ', 'WHERE=1') }, @{ ID = 'Insert'; Config = @('TEXT=ok ', 'WHERE=1') }); Expect = @('ok aa.txt') }
  @{ Name = 'FORMAT missing keys fall back to defaults'; Files = @('aa.txt'); Raw = @('[Rule0]', 'ID=Insert', 'Config=TEXT:min+;WHERE:1', 'Marked=1'); Expect = @('min aa.txt') }
  @{ Name = 'FORMAT lowercase key names are ignored'; Files = @('aa.txt'); Raw = @('[Rule0]', 'ID=Insert', 'Config=text:low+;where:1', 'Marked=1'); Expect = @('aa.txt') }
  @{ Name = 'FORMAT section numbering may start at 1 / have gaps (applied in numeric order)'; Files = @('aa.txt'); Raw = @('[Rule1]', 'ID=Insert', 'Config=TEXT:r1+;WHERE:1', 'Marked=1', '', '[Rule3]', 'ID=Insert', 'Config=TEXT:r3+;WHERE:1', 'Marked=1'); Expect = @('r3 r1 aa.txt') }
  @{ Name = 'FORMAT missing Marked line = marked'; Files = @('aa.txt'); Raw = @('[Rule0]', 'ID=Insert', 'Config=TEXT:nm+;WHERE:1'); Expect = @('nm aa.txt') }
  @{ Name = 'FORMAT unknown ID is silently skipped'; Files = @('aa.txt'); Raw = @('[Rule0]', 'ID=Bogus', 'Config=X:1', 'Marked=1', '', '[Rule1]', 'ID=Insert', 'Config=TEXT:after+;WHERE:1', 'Marked=1'); Expect = @('after aa.txt') }
  @{ Name = 'FORMAT Comment is URL-encoded and harmless'; Files = @('aa.txt'); Rules = @(@{ ID = 'Insert'; Comment = 'Adds "c" — test'; Config = @('TEXT=c ', 'WHERE=1') }); Expect = @('c aa.txt') }
  # ---------------- Insert ----------------
  @{ Name = 'Insert WHERE=1 prefix'; Files = @('hello world.txt'); Rules = @(@{ ID = 'Insert'; Config = @('TEXT=X', 'WHERE=1', 'POSITION=3', 'INSERTAFTERTEXT=o', 'INSERTBEFORETEXT=w', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1') }); Expect = @('Xhello world.txt') }
  @{ Name = 'Insert WHERE=2 suffix (before ext when SKIPEXTENSION=1)'; Files = @('hello world.txt'); Rules = @(@{ ID = 'Insert'; Config = @('TEXT=X', 'WHERE=2', 'POSITION=3', 'INSERTAFTERTEXT=o', 'INSERTBEFORETEXT=w', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1') }); Expect = @('hello worldX.txt') }
  @{ Name = 'Insert WHERE=2 suffix with SKIPEXTENSION=0 goes after ext'; Files = @('hello world.txt'); Rules = @(@{ ID = 'Insert'; Config = @('TEXT=X', 'WHERE=2', 'POSITION=1', 'INSERTAFTERTEXT=', 'INSERTBEFORETEXT=', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=0') }); Expect = @('hello world.txtX') }
  @{ Name = 'Insert WHERE=3 legacy: suffix before ext even with SKIPEXTENSION=0'; Files = @('hello world.txt'); Rules = @(@{ ID = 'Insert'; Config = @('TEXT=X', 'WHERE=3', 'POSITION=3', 'INSERTAFTERTEXT=o', 'INSERTBEFORETEXT=w', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=0') }); Expect = @('hello worldX.txt') }
  @{ Name = 'Insert WHERE=4 position 3'; Files = @('hello world.txt'); Rules = @(@{ ID = 'Insert'; Config = @('TEXT=X', 'WHERE=4', 'POSITION=3', 'INSERTAFTERTEXT=o', 'INSERTBEFORETEXT=w', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1') }); Expect = @('heXllo world.txt') }
  @{ Name = 'Insert WHERE=4 position 3 right-to-left'; Files = @('hello world.txt'); Rules = @(@{ ID = 'Insert'; Config = @('TEXT=X', 'WHERE=4', 'POSITION=3', 'INSERTAFTERTEXT=', 'INSERTBEFORETEXT=', 'RIGHTTOLEFT=1', 'SKIPEXTENSION=1') }); Expect = @('hello worXld.txt') }
  @{ Name = 'Insert WHERE=5 after text (every occurrence)'; Files = @('hello world.txt'); Rules = @(@{ ID = 'Insert'; Config = @('TEXT=X', 'WHERE=5', 'POSITION=3', 'INSERTAFTERTEXT=o', 'INSERTBEFORETEXT=w', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1') }); Expect = @('helloX woXrld.txt') }
  @{ Name = 'Insert WHERE=6 before text'; Files = @('hello world.txt'); Rules = @(@{ ID = 'Insert'; Config = @('TEXT=X', 'WHERE=6', 'POSITION=3', 'INSERTAFTERTEXT=o', 'INSERTBEFORETEXT=w', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1') }); Expect = @('hello Xworld.txt') }
  @{ Name = 'Insert WHERE=7 replace current name'; Files = @('hello world.txt'); Rules = @(@{ ID = 'Insert'; Config = @('TEXT=X', 'WHERE=7', 'POSITION=3', 'INSERTAFTERTEXT=o', 'INSERTBEFORETEXT=w', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1') }); Expect = @('X.txt') }
  @{ Name = 'Insert meta tag :File_FolderName:'; Files = @('sub\hello.txt'); Rules = @(@{ ID = 'Insert'; Config = @('TEXT=:File_FolderName: ', 'WHERE=1', 'POSITION=1', 'INSERTAFTERTEXT=', 'INSERTBEFORETEXT=', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1') }); Expect = @('sub\', 'sub\sub hello.txt') }
  # ---------------- Delete ----------------
  @{ Name = 'Delete FROM=1 pos2 UNTIL=1 count3'; Files = @('abc-def-ghi.txt'); Rules = @(@{ ID = 'Delete'; Config = @('FROM=1', 'UNTIL=1', 'FROMPOSITION=2', 'UNTILCOUNT=3', 'FROMDELIMITER=-', 'UNTILDELIMITER=-', 'DELETECURRENTNAME=0', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1', 'LEAVEDELIMITER=0') }); Expect = @('adef-ghi.txt') }
  @{ Name = 'Delete FROM=1 pos2 UNTIL=2 till end'; Files = @('abc-def-ghi.txt'); Rules = @(@{ ID = 'Delete'; Config = @('FROM=1', 'UNTIL=2', 'FROMPOSITION=2', 'UNTILCOUNT=3', 'FROMDELIMITER=-', 'UNTILDELIMITER=-', 'DELETECURRENTNAME=0', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1', 'LEAVEDELIMITER=0') }); Expect = @('a.txt') }
  @{ Name = 'Delete FROM=1 pos2 UNTIL=3 delimiter (removes delimiter too)'; Files = @('abc-def-ghi.txt'); Rules = @(@{ ID = 'Delete'; Config = @('FROM=1', 'UNTIL=3', 'FROMPOSITION=2', 'UNTILCOUNT=3', 'FROMDELIMITER=-', 'UNTILDELIMITER=-', 'DELETECURRENTNAME=0', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1', 'LEAVEDELIMITER=0') }); Expect = @('adef-ghi.txt') }
  @{ Name = 'Delete FROM=2 delim UNTIL=3 delim'; Files = @('abc-def-ghi.txt'); Rules = @(@{ ID = 'Delete'; Config = @('FROM=2', 'UNTIL=3', 'FROMPOSITION=2', 'UNTILCOUNT=3', 'FROMDELIMITER=-', 'UNTILDELIMITER=-', 'DELETECURRENTNAME=0', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1', 'LEAVEDELIMITER=0') }); Expect = @('abcghi.txt') }
  @{ Name = 'Delete LEAVEDELIMITER=1 keeps delimiters'; Files = @('abc-def-ghi.txt'); Rules = @(@{ ID = 'Delete'; Config = @('FROM=2', 'UNTIL=3', 'FROMPOSITION=2', 'UNTILCOUNT=3', 'FROMDELIMITER=-', 'UNTILDELIMITER=-', 'DELETECURRENTNAME=0', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1', 'LEAVEDELIMITER=1') }); Expect = @('abc--ghi.txt') }
  @{ Name = 'Delete RTL count 2 (last two chars)'; Files = @('abc-def-ghi.txt'); Rules = @(@{ ID = 'Delete'; Config = @('FROM=1', 'UNTIL=1', 'FROMPOSITION=1', 'UNTILCOUNT=2', 'FROMDELIMITER=', 'UNTILDELIMITER=', 'DELETECURRENTNAME=0', 'RIGHTTOLEFT=1', 'SKIPEXTENSION=1', 'LEAVEDELIMITER=0') }); Expect = @('abc-def-g.txt') }
  @{ Name = 'Delete RTL until delimiter (last word)'; Files = @('abc-def-ghi.txt'); Rules = @(@{ ID = 'Delete'; Config = @('FROM=1', 'UNTIL=3', 'FROMPOSITION=1', 'UNTILCOUNT=1', 'FROMDELIMITER=', 'UNTILDELIMITER=-', 'DELETECURRENTNAME=0', 'RIGHTTOLEFT=1', 'SKIPEXTENSION=1', 'LEAVEDELIMITER=0') }); Expect = @('abc-def.txt') }
  @{ Name = 'Delete DELETECURRENTNAME=1 then Insert'; Files = @('abc-def-ghi.txt'); Rules = @(@{ ID = 'Delete'; Config = @('FROM=1', 'UNTIL=1', 'FROMPOSITION=1', 'UNTILCOUNT=1', 'FROMDELIMITER=', 'UNTILDELIMITER=', 'DELETECURRENTNAME=1', 'RIGHTTOLEFT=0', 'SKIPEXTENSION=1', 'LEAVEDELIMITER=0') }, @{ ID = 'Insert'; Config = @('TEXT=new', 'WHERE=1') }); Expect = @('new.txt') }
  # ---------------- Remove / Replace ----------------
  @{ Name = 'Remove WHICH=1 first'; Files = @('a-a-a.txt'); Rules = @(@{ ID = 'Remove'; Config = @('TEXT=a', 'WHICH=1', 'SKIPEXTENSION=1', 'CASESENSITIVE=0', 'USEWILDCARDS=0', 'WHOLEWORDSONLY=0') }); Expect = @('-a-a.txt') }
  @{ Name = 'Remove WHICH=2 last'; Files = @('a-a-a.txt'); Rules = @(@{ ID = 'Remove'; Config = @('TEXT=a', 'WHICH=2', 'SKIPEXTENSION=1', 'CASESENSITIVE=0', 'USEWILDCARDS=0', 'WHOLEWORDSONLY=0') }); Expect = @('a-a-.txt') }
  @{ Name = 'Remove WHICH=3 all'; Files = @('a-a-a.txt'); Rules = @(@{ ID = 'Remove'; Config = @('TEXT=a', 'WHICH=3', 'SKIPEXTENSION=1', 'CASESENSITIVE=0', 'USEWILDCARDS=0', 'WHOLEWORDSONLY=0') }); Expect = @('--.txt') }
  @{ Name = 'Replace WHICH=0 does nothing'; Files = @('a-a-a.txt'); Rules = @(@{ ID = 'Replace'; Config = @('TEXTWHAT=a', 'TEXTWITH=b', 'WHICH=0', 'SKIPEXTENSION=1', 'CASESENSITIVE=0', 'USEWILDCARDS=0', 'WHOLEWORDSONLY=0') }); Expect = @('a-a-a.txt') }
  @{ Name = 'Replace WHICH=1 first'; Files = @('a-a-a.txt'); Rules = @(@{ ID = 'Replace'; Config = @('TEXTWHAT=a', 'TEXTWITH=b', 'WHICH=1', 'SKIPEXTENSION=1', 'CASESENSITIVE=0', 'USEWILDCARDS=0', 'WHOLEWORDSONLY=0') }); Expect = @('b-a-a.txt') }
  @{ Name = 'Replace WHICH=2 last'; Files = @('a-a-a.txt'); Rules = @(@{ ID = 'Replace'; Config = @('TEXTWHAT=a', 'TEXTWITH=b', 'WHICH=2', 'SKIPEXTENSION=1', 'CASESENSITIVE=0', 'USEWILDCARDS=0', 'WHOLEWORDSONLY=0') }); Expect = @('a-a-b.txt') }
  @{ Name = 'Replace WHICH=3 all'; Files = @('a-a-a.txt'); Rules = @(@{ ID = 'Replace'; Config = @('TEXTWHAT=a', 'TEXTWITH=b', 'WHICH=3', 'SKIPEXTENSION=1', 'CASESENSITIVE=0', 'USEWILDCARDS=0', 'WHOLEWORDSONLY=0') }); Expect = @('b-b-b.txt') }
  @{ Name = 'Replace *|* pairs'; Files = @('a-a-a.txt'); Rules = @(@{ ID = 'Replace'; Config = @('TEXTWHAT=a*|*-', 'TEXTWITH=b*|*_', 'WHICH=3', 'SKIPEXTENSION=1', 'CASESENSITIVE=0', 'USEWILDCARDS=0', 'WHOLEWORDSONLY=0') }); Expect = @('b_b_b.txt') }
  @{ Name = 'Replace WHOLEWORDSONLY (hyphen = boundary)'; Files = @('cat catalog cat-dog.txt'); Rules = @(@{ ID = 'Replace'; Config = @('TEXTWHAT=cat', 'TEXTWITH=dog', 'WHICH=3', 'SKIPEXTENSION=1', 'CASESENSITIVE=0', 'USEWILDCARDS=0', 'WHOLEWORDSONLY=1') }); Expect = @('dog catalog dog-dog.txt') }
  @{ Name = 'Replace USEWILDCARDS'; Files = @('abc123def.txt'); Rules = @(@{ ID = 'Replace'; Config = @('TEXTWHAT=c*d', 'TEXTWITH=_', 'WHICH=3', 'SKIPEXTENSION=1', 'CASESENSITIVE=0', 'USEWILDCARDS=1', 'WHOLEWORDSONLY=0') }); Expect = @('ab_ef.txt') }
  # ---------------- Rearrange ----------------
  @{ Name = 'Rearrange DELIMITERTYPE=0 delimiters, $-1'; Files = @('aa_bb_cc_dd.txt'); Rules = @(@{ ID = 'Rearrange'; Config = @('DELIMITERTYPE=0', 'RIGHTTOLEFT=0', 'DELIMETERS=_', 'NEWPATTERN=$3-$1-$-1', 'SKIPEXTENSION=1') }); Expect = @('cc-aa-dd.txt') }
  @{ Name = 'Rearrange DELIMITERTYPE=1 positions'; Files = @('aa_bb_cc_dd.txt'); Rules = @(@{ ID = 'Rearrange'; Config = @('DELIMITERTYPE=1', 'RIGHTTOLEFT=0', 'DELIMETERS=4|7', 'NEWPATTERN=$3+$1', 'SKIPEXTENSION=1') }); Expect = @('cc_dd+aa_.txt') }
  @{ Name = 'Rearrange DELIMITERTYPE=2 exact pattern'; Files = @('aa_bb_cc_dd.txt'); Rules = @(@{ ID = 'Rearrange'; Config = @('DELIMITERTYPE=2', 'RIGHTTOLEFT=0', 'DELIMETERS=_', 'NEWPATTERN=$2+$1', 'SKIPEXTENSION=1') }); Expect = @('bb_cc_dd+aa.txt') }
  @{ Name = 'Rearrange multiple delimiters'; Files = @('aa_bb-cc dd.txt'); Rules = @(@{ ID = 'Rearrange'; Config = @('DELIMITERTYPE=0', 'RIGHTTOLEFT=0', 'DELIMETERS=_|-| ', 'NEWPATTERN=$4.$3.$2.$1', 'SKIPEXTENSION=1') }); Expect = @('dd.cc.bb.aa.txt') }
  # ---------------- Extension ----------------
  @{ Name = 'Extension new (no leading dot)'; Files = @('x.txt'); Rules = @(@{ ID = 'Extension'; Config = @('NEWEXTENSION=1', 'EXTENSION=md', 'APPEND=0', 'USEBINSIGN=0', 'REMOVEDUPLICATES=0', 'CASESENSITIVE=0') }); Expect = @('x.md') }
  @{ Name = 'Extension leading dot produces double dot'; Files = @('x.txt'); Rules = @(@{ ID = 'Extension'; Config = @('NEWEXTENSION=1', 'EXTENSION=.md', 'APPEND=0', 'USEBINSIGN=0', 'REMOVEDUPLICATES=0', 'CASESENSITIVE=0') }); Expect = @('x..md') }
  @{ Name = 'Extension append'; Files = @('x.txt'); Rules = @(@{ ID = 'Extension'; Config = @('NEWEXTENSION=1', 'EXTENSION=md', 'APPEND=1', 'USEBINSIGN=0', 'REMOVEDUPLICATES=0', 'CASESENSITIVE=0') }); Expect = @('x.txt.md') }
  @{ Name = 'Extension remove duplicates (case-insensitive)'; Files = @('y.jpg.JPG'); Rules = @(@{ ID = 'Extension'; Config = @('NEWEXTENSION=0', 'EXTENSION=', 'APPEND=0', 'USEBINSIGN=0', 'REMOVEDUPLICATES=1', 'CASESENSITIVE=0') }); Expect = @('y.jpg') }
  # ---------------- Strip ----------------
  @{ Name = 'Strip WHERE=0 everywhere'; Files = @('__a_b__.txt'); Rules = @(@{ ID = 'Strip'; Config = @('CHECKENGLISHLETTERS=0', 'CHECKDIGITS=0', 'CHECKSYMBOLS=0', 'CHECKBRACKETS=0', 'CHECKUSERDEFINED=1', 'CHECKUNICODERANGE=0', 'TEXTUSERDEFINED=_', 'TEXTUNICODERANGE=', 'WHERE=0', 'STRIPALLEXCEPTSELECTED=0', 'CASESENSITIVE=0', 'SKIPEXTENSION=1') }); Expect = @('ab.txt') }
  @{ Name = 'Strip WHERE=1 leading'; Files = @('__a_b__.txt'); Rules = @(@{ ID = 'Strip'; Config = @('CHECKENGLISHLETTERS=0', 'CHECKDIGITS=0', 'CHECKSYMBOLS=0', 'CHECKBRACKETS=0', 'CHECKUSERDEFINED=1', 'CHECKUNICODERANGE=0', 'TEXTUSERDEFINED=_', 'TEXTUNICODERANGE=', 'WHERE=1', 'STRIPALLEXCEPTSELECTED=0', 'CASESENSITIVE=0', 'SKIPEXTENSION=1') }); Expect = @('a_b__.txt') }
  @{ Name = 'Strip WHERE=2 trailing'; Files = @('__a_b__.txt'); Rules = @(@{ ID = 'Strip'; Config = @('CHECKENGLISHLETTERS=0', 'CHECKDIGITS=0', 'CHECKSYMBOLS=0', 'CHECKBRACKETS=0', 'CHECKUSERDEFINED=1', 'CHECKUNICODERANGE=0', 'TEXTUSERDEFINED=_', 'TEXTUNICODERANGE=', 'WHERE=2', 'STRIPALLEXCEPTSELECTED=0', 'CASESENSITIVE=0', 'SKIPEXTENSION=1') }); Expect = @('__a_b.txt') }
  @{ Name = 'Strip all except digits'; Files = @('a1b2 c3.txt'); Rules = @(@{ ID = 'Strip'; Config = @('CHECKENGLISHLETTERS=0', 'CHECKDIGITS=1', 'CHECKSYMBOLS=0', 'CHECKBRACKETS=0', 'CHECKUSERDEFINED=0', 'CHECKUNICODERANGE=0', 'TEXTUSERDEFINED=', 'TEXTUNICODERANGE=', 'WHERE=0', 'STRIPALLEXCEPTSELECTED=1', 'CASESENSITIVE=0', 'SKIPEXTENSION=1') }); Expect = @('123.txt') }
