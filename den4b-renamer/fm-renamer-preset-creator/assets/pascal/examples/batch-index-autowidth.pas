{ Prefix each file with its position in the batch, zero-padded to the width
  of the batch size: 9 files give 1..9, 10 files give 01..10, 120 files
  give 001..120. Serialize cannot size its padding from the batch, so this
  needs a script. Order = file-table order (sorting).
  Generated by fm-renamer-preset-creator. Edit the CONFIG block only. }
const
  // --- CONFIG ---------------------------------------------------------------
  SEPARATOR = ' ';
var
  Num: WideString;
  Width: Integer;
begin
  // Width of the largest index, e.g. 3 for a batch of 120 files.
  Width := Length(IntToStr(GetTotalNumberOfFiles));
  Num := IntToStr(GetCurrentFileIndex);
  while Length(Num) < Width do
    Num := '0' + Num;
  // FileName is the current new name including the extension.
  FileName := Num + SEPARATOR + FileName;
end.
