# C1 calibration probes: multi-row Mapping and multi-line User Input, format taken from
# the GUI-saved presets in this folder. Run: ..\..\scripts\Invoke-RnpProbe.ps1 -CaseFile .\c1-probes.psd1
@{ Cases = @(
  @{ Name = 'UI1 UserInput lines separated by CR (GUI format)'; Files = @('aa.txt', 'bb.txt'); Rules = @(@{ ID = 'UserInput'; Config = @('INPUT=new1{CR}new2', 'ACTION=0', 'SKIPEXTENSION=1') }); Expect = @('new1.txt', 'new2.txt') }
  @{ Name = 'UI2 UserInput CRLF-separated list'; Files = @('aa.txt', 'bb.txt'); Rules = @(@{ ID = 'UserInput'; Config = @('INPUT=new1{CRLF}new2', 'ACTION=0', 'SKIPEXTENSION=1') }) }
  @{ Name = 'UI3 UserInput LF-separated list'; Files = @('aa.txt', 'bb.txt'); Rules = @(@{ ID = 'UserInput'; Config = @('INPUT=new1{LF}new2', 'ACTION=0', 'SKIPEXTENSION=1') }) }
  @{ Name = 'UI4 UserInput lines with spaces and punctuation'; Files = @('aa.txt', 'bb.txt'); Rules = @(@{ ID = 'UserInput'; Config = @('INPUT=one two{CR}a&b (c)', 'ACTION=0', 'SKIPEXTENSION=1') }); Expect = @('one two.txt', 'a&b (c).txt') }
  @{ Name = 'UI5 UserInput shorter list than files'; Files = @('aa.txt', 'bb.txt', 'cc.txt'); Rules = @(@{ ID = 'UserInput'; Config = @('INPUT=new1{CR}new2', 'ACTION=0', 'SKIPEXTENSION=1') }) }
  @{ Name = 'UI6 UserInput ACTION=1 with two lines'; Files = @('aa.txt', 'bb.txt'); Rules = @(@{ ID = 'UserInput'; Config = @('INPUT=x {CR}y ', 'ACTION=1', 'SKIPEXTENSION=1') }); Expect = @('x aa.txt', 'y bb.txt') }
  @{ Name = 'UI7 UserInput trailing CR'; Files = @('aa.txt', 'bb.txt'); Rules = @(@{ ID = 'UserInput'; Config = @('INPUT=new1{CR}new2{CR}', 'ACTION=0', 'SKIPEXTENSION=1') }) }
  @{ Name = 'MP1 Mapping rows joined by raw | (GUI format)'; Files = @('aa.txt', 'bb.txt', 'cc.txt'); Rules = @(@{ ID = 'Mapping'; Encoded = $true; Config = @('ALLOWREUSE=0', 'PARTIALMATCH=0', 'INVERSEMAPPING=0', 'CASESENSITIVE=0', 'SKIPEXTENSION=1', 'SOURCE=aa|bb', 'TARGET=xx|yy') }); Expect = @('cc.txt', 'xx.txt', 'yy.txt') }
  @{ Name = 'MP2 Mapping rows with special characters (GUI encoding)'; Files = @('a b-c.d.txt', 'é&(1).txt'); Rules = @(@{ ID = 'Mapping'; Encoded = $true; Config = @('ALLOWREUSE=0', 'PARTIALMATCH=0', 'INVERSEMAPPING=0', 'CASESENSITIVE=0', 'SKIPEXTENSION=1', 'SOURCE=a+b%2Dc%2Ed|%C3%A9%26%281%29', 'TARGET=x+y%5Fz|ok%2C+50%25') }); Expect = @('x y_z.txt', 'ok, 50%.txt') }
  @{ Name = 'MP3 Mapping with an encoded pipe %7C'; Files = @('aa.txt', 'bb.txt'); Rules = @(@{ ID = 'Mapping'; Config = @('ALLOWREUSE=0', 'PARTIALMATCH=0', 'INVERSEMAPPING=0', 'CASESENSITIVE=0', 'SKIPEXTENSION=1', 'SOURCE=aa|bb', 'TARGET=xx|yy') }) }
  @{ Name = 'MP4 Mapping INVERSEMAPPING with two rows'; Files = @('xx.txt', 'yy.txt'); Rules = @(@{ ID = 'Mapping'; Encoded = $true; Config = @('ALLOWREUSE=0', 'PARTIALMATCH=0', 'INVERSEMAPPING=1', 'CASESENSITIVE=0', 'SKIPEXTENSION=1', 'SOURCE=aa|bb', 'TARGET=xx|yy') }) }
  @{ Name = 'MP5 Mapping more SOURCE rows than TARGET rows'; Files = @('aa.txt', 'bb.txt'); Rules = @(@{ ID = 'Mapping'; Encoded = $true; Config = @('ALLOWREUSE=0', 'PARTIALMATCH=0', 'INVERSEMAPPING=0', 'CASESENSITIVE=0', 'SKIPEXTENSION=1', 'SOURCE=aa|bb', 'TARGET=xx') }) }
  @{ Name = 'MP6 Mapping case-insensitive match on second row'; Files = @('AA.txt', 'Bb.txt'); Rules = @(@{ ID = 'Mapping'; Encoded = $true; Config = @('ALLOWREUSE=0', 'PARTIALMATCH=0', 'INVERSEMAPPING=0', 'CASESENSITIVE=0', 'SKIPEXTENSION=1', 'SOURCE=aa|bb', 'TARGET=xx|yy') }) }
  @{ Name = 'MP7 Mapping ALLOWREUSE=0 with a duplicate source name'; Files = @('d1\aa.txt', 'd2\aa.txt'); Rules = @(@{ ID = 'Mapping'; Encoded = $true; Config = @('ALLOWREUSE=0', 'PARTIALMATCH=0', 'INVERSEMAPPING=0', 'CASESENSITIVE=0', 'SKIPEXTENSION=1', 'SOURCE=aa', 'TARGET=xx') }) }
  @{ Name = 'MP8 Mapping ALLOWREUSE=1 with a duplicate source name'; Files = @('d1\aa.txt', 'd2\aa.txt'); Rules = @(@{ ID = 'Mapping'; Encoded = $true; Config = @('ALLOWREUSE=1', 'PARTIALMATCH=0', 'INVERSEMAPPING=0', 'CASESENSITIVE=0', 'SKIPEXTENSION=1', 'SOURCE=aa', 'TARGET=xx') }) }
) }
